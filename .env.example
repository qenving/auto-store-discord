# ===================================
# AUTO-STORE ECOSYSTEM - ENVIRONMENT
# ===================================

# Mode: DiscordBotOnly | WebOnly | IntegratedMode
MODE=IntegratedMode

# Database Configuration
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=autostore

MONGODB_URI=mongodb://localhost:27017/autostore

# Discord Bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=

# Discord OAuth2 (for website login)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Website
WEBSITE_URL=http://localhost:3000
WEBSITE_PORT=3000
JWT_SECRET=
SESSION_SECRET=
ADMIN_SECRET_KEY=

# Payment Gateway (choose one: midtrans | duitku | tripay)
PAYMENT_PROVIDER=midtrans
PAYMENT_AUTO_EXPIRE_MINUTES=15

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Duitku
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_CALLBACK_URL=

# Tripay
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_CALLBACK_URL=

# Features
FEATURE_AUTO_DELIVERY=true
FEATURE_AUTO_EXPIRE_INVOICE=true
FEATURE_TESTIMONI_INTEGRATION=true
MAINTENANCE_MODE=false

# Limits
MAX_PENDING_ORDERS=5
MIN_DEPOSIT=10000
MAX_DEPOSIT=10000000

# Logging
LOG_LEVEL=info
LOG_FILE_ENABLED=true
